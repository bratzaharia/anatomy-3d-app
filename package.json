{
  "name": "human-anatomy-3d-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @anatomy/web dev",
    "dev:asset-preview": "pnpm --filter @anatomy/web exec vite --host 127.0.0.1 --port 5180 --strictPort",
    "verify:asset-preview": "node tools/anatomy-assets/verify-isolated-preview.mjs",
    "build": "pnpm typecheck && pnpm --filter @anatomy/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:anatomy": "node --import tsx tools/anatomy-assets/validate-anatomy.ts && node --import tsx tools/anatomy-assets/validate-skeletal-parts.ts && node --import tsx tools/anatomy-assets/validate-muscles.ts && node --import tsx tools/anatomy-assets/validate-nervous.ts && node --import tsx tools/anatomy-assets/validate-nervous-coverage.ts && pnpm validate:spinal-candidates && pnpm validate:venous && pnpm validate:brain && pnpm validate:heart",
    "validate:spinal-candidates": "node --import tsx tools/anatomy-assets/validate-spinal-candidates.ts",
    "validate:i18n": "node --import tsx tools/anatomy-assets/validate-i18n.ts",
    "import:venous": "node tools/anatomy-assets/import-venous.mjs",
    "validate:venous": "node --import tsx tools/anatomy-assets/validate-venous.ts",
    "validate:brain": "node --import tsx tools/anatomy-assets/audit-brain.ts",
    "brain:audit": "node --import tsx tools/anatomy-assets/audit-brain.ts --write",
    "brain:prepare-atlas": "node --import tsx tools/anatomy-assets/prepare-brain-atlas.ts",
    "import:heart": "node tools/anatomy-assets/import-heart.mjs",
    "validate:heart": "node --import tsx tools/anatomy-assets/validate-heart.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "meshoptimizer": "1.1.1",
    "zod": "4.6.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
